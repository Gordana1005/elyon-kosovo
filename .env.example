VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Server-only — used by scripts/ for bulk imports. NEVER ship to the browser.
# Get it from Supabase Dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Phase 1 (no telephony yet): keep the dialer disabled. Set to "true" only after the
# Kosovo PBX/SIP trunk is live (Phase 2 - see deploy-kit/07-TELEPHONY-LATER.md).
VITE_USE_REAL_VOIP="false"
