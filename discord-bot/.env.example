# ============================================================================
#  Elyon Discord Bot — environment configuration
#  Copy this file to ".env" and fill in the values. NEVER commit ".env".
#  See docs/discord-bot/CHECKLIST.md for exactly where each value comes from.
# ============================================================================

# ---- Discord application (from https://discord.com/developers/applications) --
DISCORD_TOKEN=                       # Bot token (Bot tab → Reset Token)
DISCORD_CLIENT_ID=                   # Application ID (General Information)
DISCORD_GUILD_ID=                    # Your server's ID (right-click server → Copy Server ID)

# ---- Discord role IDs (right-click each role → Copy Role ID) ----------------
#  The bot's "setup-server" step prints these after it creates/finds the roles.
#  Role gating is enforced IN CODE against these IDs (fail-closed).
DISCORD_SUPERADMIN_ROLE_ID=          # REQUIRED — the only tier that can do everything
DISCORD_TEAMLEAD_ROLE_ID=            # optional
DISCORD_AGENT_ROLE_ID=               # optional (needed for agent self-service commands)
DISCORD_WAREHOUSE_ROLE_ID=           # optional

# ---- Audit log channel (optional but recommended for GDPR) ------------------
DISCORD_AUDIT_CHANNEL_ID=            # bot logs "who ran what" here (#bot-audit)

# ---- Elyon CRM database (READ-ONLY role) -----------------------------------
#  Create the SELECT-only role in Supabase first (see CHECKLIST.md), then use the
#  Session pooler connection string. The bot can ONLY read.
DATABASE_URL=postgresql://discord_bot_ro:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require
DB_SSL=true

# ---- Behaviour --------------------------------------------------------------
BOT_TZ=Europe/Sofia                  # day boundaries for "today"/daily reports
IDENTITY_DB_PATH=./data/identity.json # bot-owned Discord<->CRM-agent map (no CRM writes)
