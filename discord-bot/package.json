{
  "name": "elyon-discord-bot",
  "private": true,
  "version": "0.1.0",
  "description": "Read-only Discord bot for the Elyon CRM. Slash commands for order status, agent reports, COD reconciliation, callbacks, work time and more. No LLM, free to run, strictly read-only.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "deploy-commands": "tsx src/deploy-commands.ts",
    "setup-server": "tsx src/scripts/setup-discord-server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.7",
    "luxon": "^3.5.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
